# Stage 1: download and extract binaries
FROM rockylinux:9 AS builder

ARG HADOOP_VERSION=3.3.6
ARG HBASE_VERSION=2.5.15
ARG ZK_VERSION=3.8.6
RUN dnf install -y --allowerasing curl && rm -rf /var/cache/dnf

# dlcdn.apache.org ne garde que le dernier release de chaque branche : les
# versions remplacees migrent sur archive.apache.org (HBase 2.5.15 et
# ZooKeeper 3.8.6 y sont deja). On tente dlcdn puis l'archive, et on
# telecharge avant d'extraire pour eviter une extraction partielle sur 404.
RUN set -eux; \
    rel="hadoop/common/hadoop-$HADOOP_VERSION/hadoop-$HADOOP_VERSION.tar.gz"; \
    curl -fsSL --retry 3 -o /tmp/hadoop.tar.gz "https://dlcdn.apache.org/$rel" \
      || curl -fsSL --retry 3 -o /tmp/hadoop.tar.gz "https://archive.apache.org/dist/$rel"; \
    tar xzf /tmp/hadoop.tar.gz -C /opt; \
    rm /tmp/hadoop.tar.gz; \
    mv /opt/hadoop-$HADOOP_VERSION /opt/hadoop

RUN set -eux; \
    rel="hbase/$HBASE_VERSION/hbase-$HBASE_VERSION-hadoop3-bin.tar.gz"; \
    curl -fsSL --retry 3 -o /tmp/hbase.tar.gz "https://dlcdn.apache.org/$rel" \
      || curl -fsSL --retry 3 -o /tmp/hbase.tar.gz "https://archive.apache.org/dist/$rel"; \
    tar xzf /tmp/hbase.tar.gz -C /opt; \
    rm /tmp/hbase.tar.gz; \
    mv /opt/hbase-$HBASE_VERSION-hadoop3 /opt/hbase

RUN set -eux; \
    rel="zookeeper/zookeeper-$ZK_VERSION/apache-zookeeper-$ZK_VERSION-bin.tar.gz"; \
    curl -fsSL --retry 3 -o /tmp/zookeeper.tar.gz "https://dlcdn.apache.org/$rel" \
      || curl -fsSL --retry 3 -o /tmp/zookeeper.tar.gz "https://archive.apache.org/dist/$rel"; \
    tar xzf /tmp/zookeeper.tar.gz -C /opt; \
    rm /tmp/zookeeper.tar.gz; \
    mv /opt/apache-zookeeper-$ZK_VERSION-bin /opt/zookeeper

RUN rm -rf \
    /opt/hadoop/share/doc \
    /opt/hbase/docs \
    /opt/zookeeper/docs \
  && find /opt \( -name "*.bat" -o -name "*.cmd" -o -name "*.ps1" -o -name "*.a" \) -delete

# Stage 2: runtime image
FROM rockylinux:9

LABEL description="Hadoop 3.3.6 + HBase 2.5.15 + ZooKeeper 3.8.6 - Learning Cluster"
LABEL maintainer="Hadoop Docker Learning"

ENV JAVA_HOME=/usr/lib/jvm/jre-11-openjdk
ENV HADOOP_HOME=/opt/hadoop
ENV HBASE_HOME=/opt/hbase
ENV ZK_HOME=/opt/zookeeper
ENV HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
ENV HBASE_CONF_DIR=$HBASE_HOME/conf
ENV HDFS_NAMENODE_USER=root
ENV HDFS_DATANODE_USER=root
ENV HDFS_SECONDARYNAMENODE_USER=root
ENV YARN_RESOURCEMANAGER_USER=root
ENV YARN_NODEMANAGER_USER=root
ENV PATH=$PATH:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HBASE_HOME/bin:$ZK_HOME/bin

RUN dnf install -y --allowerasing \
        java-11-openjdk-headless java-11-openjdk-devel \
        openssh-server openssh-clients \
        nmap-ncat nano \
        which \
    && dnf install -y epel-release \
    && dnf install -y python3.11 python3.11-pip \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/pip3.11 /usr/bin/pip3 \
    && dnf clean all && rm -rf /var/cache/dnf

RUN python3 -m pip install --no-cache-dir \
        pandas matplotlib happybase thriftpy2

RUN ssh-keygen -t rsa -P '' -f /root/.ssh/id_rsa && \
    cat /root/.ssh/id_rsa.pub >> /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/authorized_keys && \
    ssh-keygen -t rsa -f /etc/ssh/ssh_host_rsa_key -N '' 2>/dev/null && \
    ssh-keygen -t ecdsa -f /etc/ssh/ssh_host_ecdsa_key -N '' 2>/dev/null

COPY --from=builder /opt/hadoop $HADOOP_HOME
COPY --from=builder /opt/hbase $HBASE_HOME
COPY --from=builder /opt/zookeeper $ZK_HOME

RUN mkdir -p /data/hdfs/namenode /data/hdfs/datanode /data/zookeeper /opt/scripts /home/src /var/run/sshd

COPY config/core-site.xml $HADOOP_CONF_DIR/core-site.xml
COPY config/hdfs-site.xml $HADOOP_CONF_DIR/hdfs-site.xml
COPY config/mapred-site.xml $HADOOP_CONF_DIR/mapred-site.xml
COPY config/yarn-site.xml $HADOOP_CONF_DIR/yarn-site.xml
COPY config/hbase-site.xml $HBASE_CONF_DIR/hbase-site.xml
COPY config/zoo.cfg $ZK_HOME/conf/zoo.cfg
COPY config/datanodes $HADOOP_CONF_DIR/workers
COPY config/datanodes $HBASE_CONF_DIR/regionservers
COPY scripts/entrypoint.sh /opt/scripts/entrypoint.sh
COPY scripts/master/ /home/

RUN chmod +x /opt/scripts/entrypoint.sh /home/*.sh && \
    echo "alias clear='printf \"\\033c\"'" >> /etc/bashrc

WORKDIR /home

EXPOSE 9870 8088 8042 16010 2181 9000 9090 9091

ENTRYPOINT ["/opt/scripts/entrypoint.sh"]
